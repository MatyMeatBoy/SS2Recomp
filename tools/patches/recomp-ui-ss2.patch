+static void draw_local_multiplayer(LauncherModel* m) {
+    if(!m->local_multiplayer_prepare) return;
+    if(m->local_multiplayer_open && !ImGui::IsPopupOpen("Multijugador local")) ImGui::OpenPopup("Multijugador local");
+    ImGui::SetNextWindowSize(ImVec2(px(590),0),ImGuiCond_Appearing);
+    if(!ImGui::BeginPopupModal("Multijugador local",&m->local_multiplayer_open,ImGuiWindowFlags_AlwaysAutoResize)) return;
+    ImGui::SliderInt("Jugadores / ventanas",&m->local_players,1,4);
+    ImGui::InputInt("Monitor (-1: segundo si existe)",&m->local_display);
+    ImGui::TextWrapped("Los monitores y mandos se numeran desde 0. Se usa el area disponible del monitor elegido.");
+    const char* layouts[]={"Automatico (4: cuadricula 2x2)","Columnas","Filas"};
+    ImGui::Combo("Distribucion",&m->local_layout,layouts,3);
+    ImGui::Checkbox("Escala entera (puede dejar bordes)",&m->local_integer_scale);
+    ImGui::TextWrapped("Vista adaptativa sin estirar y colores RAW. Las consolas quedan conectadas internamente; entra a Modo Multijugador dentro del juego.");
+    for(int i=0;i<m->local_players;++i) {
+        char label[64]; std::snprintf(label,sizeof(label),"Mando del jugador %d (-1: teclado)",i+1);
+        ImGui::InputInt(label,&m->local_controllers[i]);
+    }
+    ImGui::SliderInt("Zona muerta del stick",&m->local_deadzone,1000,30000);
+    m->local_audio_player=std::clamp(m->local_audio_player,0,m->local_players-1);
+    if(m->local_players>1) ImGui::SliderInt("Audio del jugador",&m->local_audio_player,0,m->local_players-1);
+    ImGui::TextWrapped("Cada jugador tiene su propia partida. El teclado controla la ventana enfocada: flechas, X/Z, Enter, Shift derecho, C/V. Cerrar una ventana termina la sesion y guarda a todos.");
+    if(m->local_error[0]) ImGui::TextWrapped("%s",m->local_error);
+    ImGui::BeginDisabled(!launcher_model_can_launch(m));
+    if(ImGui::Button("Iniciar multijugador local",ImVec2(px(260),px(36)))) {
+        RecompLauncherCNetplayLaunch launch{};
+        if(!mod_commit_netplay_launch(m)) std::snprintf(m->local_error,sizeof(m->local_error),"%s",m->mod_status);
+        else if(m->local_multiplayer_prepare(m->local_players,m->local_display,m->local_layout,m->local_integer_scale,
+            m->local_audio_player,m->local_deadzone,m->local_controllers,&launch,m->local_error,sizeof(m->local_error))) {
+            m->s.netplay_launch=launch; m->local_multiplayer_open=false; m->action=LNG_ACTION_LAUNCH; ImGui::CloseCurrentPopup();
+        }
+    }
+    ImGui::EndDisabled(); ImGui::SameLine();
+    if(ImGui::Button("Cancelar")) {m->local_multiplayer_open=false;ImGui::CloseCurrentPopup();}
+    ImGui::EndPopup();
+}
