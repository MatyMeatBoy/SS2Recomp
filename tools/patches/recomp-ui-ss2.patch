+static void draw_experimental_netplay(LauncherModel* m) {
+    if (!m->experimental_netplay_prepare) return;
+    if (m->experimental_netplay_open && !ImGui::IsPopupOpen("Netplay experimental - LAN / Hamachi"))
+        ImGui::OpenPopup("Netplay experimental - LAN / Hamachi");
+    ImGui::SetNextWindowSize(ImVec2(px(510), 0), ImGuiCond_Appearing);
+    if (!ImGui::BeginPopupModal("Netplay experimental - LAN / Hamachi", &m->experimental_netplay_open,
+            ImGuiWindowFlags_AlwaysAutoResize)) return;
+    ImGui::TextWrapped("Conexion directa con recuperacion automatica. Todos deben usar la misma version, sala y numero de jugadores.");
+    ImGui::Spacing();
+    ImGui::SliderInt("Jugadores", &m->experimental_players, 2, 4);
+    const char* seats[] = {"Anfitrion (jugador 1)", "Invitado (jugador 2)", "Invitado (jugador 3)", "Invitado (jugador 4)"};
+    if (m->experimental_seat >= m->experimental_players) m->experimental_seat = m->experimental_players - 1;
+    ImGui::Combo("Mi asiento", &m->experimental_seat, seats, m->experimental_players);
+    if (m->experimental_seat)
+        ImGui::InputText("IP del anfitrion", m->experimental_host, sizeof(m->experimental_host));
+    else
+        ImGui::TextWrapped("Comparte tu IPv4 de Hamachi con los invitados. Permite este programa en el firewall de esa red.");
+    ImGui::InputInt("Sala", &m->experimental_session, 1, 100);
+    ImGui::InputInt("Puerto TCP", &m->experimental_port, 1, 100);
+    ImGui::Spacing();
+    ImGui::TextWrapped("El juego espera a todos. Entra al multijugador dentro del juego. Si se corta la red, espera su regreso. Para otra partida usa otra sala.");
+    draw_netplay_view(m);
+    if (m->experimental_error[0]) ImGui::TextWrapped("%s", m->experimental_error);
+    const bool ready = launcher_model_can_launch(m) && m->experimental_session > 0 &&
+        m->experimental_port >= 1024 && m->experimental_port <= 65535;
+    if (!launcher_model_can_launch(m)) ImGui::TextWrapped("Selecciona primero una ROM y BIOS validos en el launcher.");
+    ImGui::BeginDisabled(!ready);
+    if (ImGui::Button(m->experimental_seat ? "Conectar" : "Crear sala", ImVec2(px(180), px(36)))) {
+        RecompLauncherCNetplayLaunch launch{};
+        if (!mod_commit_netplay_launch(m)) {
+            std::snprintf(m->experimental_error, sizeof(m->experimental_error), "%s", m->mod_status);
+        } else if (m->experimental_netplay_prepare(m->experimental_players, m->experimental_seat,
+                static_cast<uint32_t>(m->experimental_session), m->experimental_port,
+                m->experimental_host, &launch, m->experimental_error, sizeof(m->experimental_error))) {
+            m->s.netplay_launch = launch;
+            m->experimental_netplay_open = false;
+            m->action = LNG_ACTION_LAUNCH;
+            ImGui::CloseCurrentPopup();
+        }
+    }
+    ImGui::EndDisabled();
+    ImGui::SameLine();
+    if (ImGui::Button("Cancelar", ImVec2(px(110), px(36)))) {
+        m->experimental_netplay_open = false;
+        ImGui::CloseCurrentPopup();
+    }
+    ImGui::EndPopup();
+}
